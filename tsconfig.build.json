{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "out",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "dist-verify",
    "build",
    "wyp",
    "test",
    ".cuckooCode",
    ".playwright-mcp",
    "src/providers/hooks",
    "src/ui/shell",
    "src/components",
    "src/hooks",
    "src/lib",
    "src/ui/cuko"
  ]
}
